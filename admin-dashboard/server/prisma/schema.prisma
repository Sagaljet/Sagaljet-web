// Side Card Model - Connected to Design
model SideCard {
  id           Int      @id @default(autoincrement())
  label        String
  title        String
  buttonText   String   @default("Order Now")
  badge        String?
  image        String? // Optional custom image, otherwise use design image
  discount     Float? // Discount percentage or amount
  discountType String?  @default("percentage") // "percentage" or "fixed"
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relation to Design
  Design   Design? @relation(fields: [designId], references: [id], onDelete: Cascade)
  designId Int?

  @@map("side_cards")
}

model Feature {
  id        Int    @id @default(autoincrement())
  name      String // e.g. "Material"
  value     String // e.g. "Glossy"
  extraCost Float  @default(0)
  designId  Int
  design    Design @relation(fields: [designId], references: [id], onDelete: Cascade)
}

model Order {
  id         String   @id @default(cuid())
  designId   Int
  design     Design   @relation(fields: [designId], references: [id])
  size       String
  quantity   Int
  color      String
  customText String?
  status     String   @default("pending")
  totalPrice Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model OrderDesign {
  id          Int      @id @default(autoincrement())
  title       String
  price       Float
  images      String[]
  size        String?
  postType    PostType @default(FACEBOOK_POST)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum PostType {
  FACEBOOK_POST
  INSTAGRAM_POST
  INSTAGRAM_STORY
  TIKTOK
  YOUTUBE_THUMBNAIL
  TWITTER
  LINKEDIN
  OTHER
}
